{
  "name": "encre-humaine",
  "version": "0.0.0",
  "private": true,
  "description": "Site L'Encre Humaine — conseil RH & accompagnement + boutique serious games",
  "type": "module",
  "packageManager": "pnpm@10.34.4",
  "engines": {
    "node": "v26.8.1",
    "pnpm": "12.3.4"
  },
  "scripts": {
    "dev": "pnpm --filter @encre/web dev",
    "build": "pnpm --filter @encre/web build",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "test:e2e": "pnpm --filter @encre/web test:e2e",
    "db:generate": "pnpm --filter @encre/db db:generate",
    "db:migrate": "pnpm --filter @encre/db db:migrate",
    "directus:snapshot": "pnpm --filter @encre/directus snapshot",
    "directus:apply": "pnpm --filter @encre/directus apply",
    "directus:types": "pnpm --filter @encre/directus types"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.2",
    "typescript": "6.0.3",
    "vitest": "4.1.9"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "@parcel/watcher",
      "vue-demi"
    ],
    "overrides": {
      "@types/node": "25.9.4",
      "postcss": "8.5.25"
    }
  }
}
