# ──────────────────────────────────────────────────────────────────────────
# Surcouche DEV LOCAL — copier en `.env.local` (gitignoré) et ajuster.
#
# Modèle de config : UNE source canonique = infra/env/.env (socle partagé,
# chargé en premier par nuxt.config en dev). Ce fichier ne contient QUE les
# clés dont la valeur doit différer sur le poste de dev — il PRIME sur le socle.
# Tout le reste (Resend, Stripe secret, Directus token, VAT…) vient du socle :
# ne le redéclare PAS ici, sinon tu recrées la duplication qu'on a éliminée.
#
# Pré-requis : `make cms-up` (Directus + Postgres exposés en local).
# ──────────────────────────────────────────────────────────────────────────

# App servie en local (pas le domaine de prod)
BASE_URL=http://localhost:3000

# En dev on veut voir le vrai site, pas la page d'attente
COMING_SOON=false

# Postgres : depuis l'hôte → 127.0.0.1 + port exposé (overlay dev, cf. Makefile).
# Le socle pointe sur le hostname Docker `postgres`, injoignable hors conteneur.
APP_DATABASE_URL=postgresql://app_user:change-me-app@127.0.0.1:55432/encre?search_path=app

# Directus : instance locale (make cms-up) au lieu du sous-domaine cms.
DIRECTUS_PUBLIC_URL=http://127.0.0.1:8055

# Stripe : secret du webhook local (donné par `stripe listen`) + tarif de test.
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_SHIPPING_RATE_FR=shr_xxx

# Turnstile : clés de TEST publiques Cloudflare (toujours « pass »). Telles quelles.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
