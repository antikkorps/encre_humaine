# ──────────────────────────────────────────────────────────────────────────
# L'Encre Humaine — variables d'environnement (docs/07-deploy.md §5)
# Copier en `.env` et renseigner. JAMAIS committer le `.env` réel.
# `web` valide ces variables au boot (docs/06 §5) et refuse de démarrer sinon.
# ──────────────────────────────────────────────────────────────────────────

# Domaine
BASE_URL=https://encrehumaine.fr

# ── Postgres ────────────────────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=encre
# Superuser (init du cluster + création des rôles/schémas via init.sql)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-postgres
# Mots de passe des rôles applicatifs (consommés par init.sql)
APP_DB_PASSWORD=change-me-app
DIRECTUS_DB_PASSWORD=change-me-directus
UMAMI_DB_PASSWORD=change-me-umami
# URL de l'app (schéma app uniquement)
APP_DATABASE_URL=postgres://app_user:change-me-app@postgres:5432/encre?search_path=app

# ── Directus ────────────────────────────────────────────────────────────────
DIRECTUS_KEY=change-me-directus-key
DIRECTUS_SECRET=change-me-directus-secret
DIRECTUS_DB_URL=postgres://directus_user:change-me-directus@postgres:5432/encre
DIRECTUS_ADMIN_EMAIL=admin@encrehumaine.fr
DIRECTUS_ADMIN_PASSWORD=change-me-admin
DIRECTUS_PUBLIC_URL=https://cms.encrehumaine.fr
# Token lecture seule, published only (consommé côté serveur Nuxt)
DIRECTUS_READ_TOKEN=change-me-readonly-token

# ── Stripe ──────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_SHIPPING_RATE_FR=shr_xxx
# VAT_ENABLED : bascule franchise → assujetti (ADR #4). Strictement "true"/"false".
VAT_ENABLED=false
VAT_RATE=0

# ── Resend ──────────────────────────────────────────────────────────────────
RESEND_API_KEY=re_xxx
RESEND_AUDIENCE_ID=aud_xxx
NEWSLETTER_FROM=L'Encre Humaine <contact@encrehumaine.fr>
CONTACT_NOTIFY_TO=eleonore@encrehumaine.fr

# ── Turnstile (anti-bot) ────────────────────────────────────────────────────
TURNSTILE_SITE_KEY=xxx
TURNSTILE_SECRET_KEY=xxx

# ── Prise de RDV (Cal.com — nom agnostique du provider) ─────────────────────
# URL publique de réservation. Provider interchangeable (Cal.com, Calendly…) :
# seul l'embed connaît le provider, le reste du code reste générique.
BOOKING_URL=https://cal.com/eleonore/decouverte

# ── R2 (storage Directus + backups) ─────────────────────────────────────────
R2_ENDPOINT=https://xxx.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=xxx
R2_SECRET_ACCESS_KEY=xxx
R2_BUCKET_ASSETS=encre-assets
R2_BUCKET_BACKUPS=encre-backups

# ── Backups (pg_dump chiffré → R2) — docs/07 §6 ─────────────────────────────
# Passphrase de chiffrement GPG (AES256). À conserver HORS de l'hôte : sans elle,
# les sauvegardes sont définitivement irrécupérables.
BACKUP_PASSPHRASE=change-me-backup-passphrase
# Planification cron (UTC) du conteneur de sauvegarde. Défaut : 03:00 chaque jour.
BACKUP_CRON=0 3 * * *
# Rétention GFS-lite : nombre de quotidiens + d'hebdomadaires conservés.
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4

# ── Umami (analytics cookieless) ────────────────────────────────────────────
UMAMI_DB_URL=postgres://umami_user:change-me-umami@postgres:5432/encre
UMAMI_APP_SECRET=change-me-umami-secret

# ── Caddy / Cloudflare (DNS-01) ─────────────────────────────────────────────
# Scope : DNS edit de la zone
CLOUDFLARE_API_TOKEN=xxx
