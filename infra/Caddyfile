# Caddyfile — reverse proxy + TLS (Cloudflare DNS-01) + en-têtes sécurité + CSP.
# docs/07-deploy.md §2, docs/06-security.md §6.
# Image Caddy custom (infra/caddy/Dockerfile) : Caddy + module caddy-dns/cloudflare.
{
	email admin@encrehumaine.fr
}

# ── En-têtes de sécurité communs (docs/06 §6) ────────────────────────────────
(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "SAMEORIGIN"
		Permissions-Policy "geolocation=(), microphone=(), camera=(), interest-cohort=()"
		-Server
	}
}

# ── CSP stricte avec allow-list des tiers (Stripe / Cal.com / Turnstile / Umami / R2) ─
# Prise de RDV : Cal.com (embed.js sur app.cal.com, iframe sur cal.com/app.cal.com).
(csp) {
	header Content-Security-Policy "default-src 'self';
		script-src 'self' https://js.stripe.com https://challenges.cloudflare.com https://app.cal.com https://stats.encrehumaine.fr;
		style-src 'self' 'unsafe-inline';
		img-src 'self' data: blob: https://cms.encrehumaine.fr https://*.r2.cloudflarestorage.com https://*.stripe.com https://app.cal.com;
		font-src 'self' data:;
		connect-src 'self' https://api.stripe.com https://cms.encrehumaine.fr https://stats.encrehumaine.fr https://challenges.cloudflare.com https://app.cal.com;
		frame-src https://js.stripe.com https://checkout.stripe.com https://challenges.cloudflare.com https://cal.com https://app.cal.com;
		frame-ancestors 'self';
		base-uri 'self';
		form-action 'self' https://checkout.stripe.com;
		object-src 'none'"
}

# ── Site public (Nuxt/Nitro) ─────────────────────────────────────────────────
encrehumaine.fr, www.encrehumaine.fr {
	import security_headers
	import csp
	encode zstd gzip
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	}
	reverse_proxy web:3000
}

# ── CMS Directus ─────────────────────────────────────────────────────────────
cms.encrehumaine.fr {
	import security_headers
	encode zstd gzip
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	}
	reverse_proxy directus:8055
}

# ── Analytics Umami (self-hosted, cookieless) ────────────────────────────────
stats.encrehumaine.fr {
	import security_headers
	encode zstd gzip
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	}
	reverse_proxy umami:3000
}
