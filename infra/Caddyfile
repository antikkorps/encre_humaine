# Caddyfile — reverse proxy + TLS (Cloudflare DNS-01) + en-têtes sécurité + CSP.
# docs/07-deploy.md §2, docs/06-security.md §6.
# Image Caddy custom (infra/caddy/Dockerfile) : Caddy + module caddy-dns/cloudflare.
{
	email admin@encrehumaine.fr

	# ── IP cliente de confiance (audit sécu #1) ──────────────────────────────
	# Caddy résout lui-même l'IP cliente réelle et la transmet à l'app, qui ne
	# lit QUE l'X-Forwarded-For posé ici (cf. server/utils/client-ip.ts).
	# `trusted_proxies static` = module intégré (aucun module à compiler).
	#  • Requête venant d'une IP Cloudflare (proxy orange) → on lit `CF-Connecting-IP`.
	#  • Requête en direct (grey cloud OU attaque sur l'origine) → l'expéditeur
	#    n'est PAS un proxy de confiance → ses en-têtes sont IGNORÉS, l'IP retenue
	#    est celle du pair. ⇒ `CF-Connecting-IP` n'est JAMAIS forgeable, même sans
	#    firewall. Le firewall origine→IP CF reste recommandé en défense en
	#    profondeur (cf. .forgejo/workflows/README.md §firewall).
	# ⚠️ Plages CF figées ci-dessous : à revérifier au déploiement contre la
	#    liste canonique https://www.cloudflare.com/ips/ (elles bougent rarement).
	servers {
		client_ip_headers Cf-Connecting-Ip
		trusted_proxies static \
 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 \
 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 \
 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 \
 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 \
 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 \
 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32 \
 private_ranges
	}
}

# ── En-têtes de sécurité communs (docs/06 §6) ────────────────────────────────
(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "SAMEORIGIN"
		Permissions-Policy "geolocation=(), microphone=(), camera=(), interest-cohort=()"
		-Server
	}
}

# ── CSP & en-têtes du SITE PUBLIC : posés par l'app (module nuxt-security) ────
# La CSP est **à nonce** (script-src sans 'unsafe-inline') : Nuxt émet un <script>
# inline de config qui doit porter un nonce par requête — impossible à gérer
# proprement depuis Caddy. nuxt-security pose donc CSP + HSTS + X-Frame-Options +
# Referrer-Policy + Permissions-Policy + COOP sur les réponses du site (cf.
# apps/web/nuxt.config.ts §security). Caddy ne double pas ces en-têtes ici (sinon
# en-têtes dupliqués) ; il les garde pour cms./stats. qui ne passent PAS par Nuxt.

# ── Site public (Nuxt/Nitro) ─────────────────────────────────────────────────
encrehumaine.fr, www.encrehumaine.fr {
	encode zstd gzip
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	}
	reverse_proxy web:3000 {
		# Anti-spoofing du rate-limit : on ÉCRASE l'X-Forwarded-For entrant par
		# l'IP cliente résolue par Caddy (`{client_ip}`, cf. global `servers`),
		# non forgeable. On retire aussi le `CF-Connecting-IP` entrant : l'app ne
		# le lit plus et il n'a rien à faire en amont.
		header_up X-Forwarded-For {client_ip}
		header_up -CF-Connecting-IP
	}
}

# ── CMS Directus ─────────────────────────────────────────────────────────────
cms.encrehumaine.fr {
	import security_headers
	encode zstd gzip
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	}
	reverse_proxy directus:8055
}

# ── Analytics Umami (self-hosted, cookieless) ────────────────────────────────
stats.encrehumaine.fr {
	import security_headers
	encode zstd gzip
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	}
	reverse_proxy umami:3000
}
