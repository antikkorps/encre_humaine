# Caddyfile — reverse proxy + TLS (Cloudflare DNS-01) + en-têtes sécurité + CSP.
# docs/07-deploy.md §2, docs/06-security.md §6.
# Image Caddy à builder avec le module caddy-dns/cloudflare (item BACKLOG).

{
	email admin@lencre-humaine.com
}

# ── En-têtes de sécurité communs (docs/06 §6) ────────────────────────────────
(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "SAMEORIGIN"
		Permissions-Policy "geolocation=(), microphone=(), camera=(), interest-cohort=()"
		-Server
	}
}

# ── CSP stricte avec allow-list des tiers (Stripe / Calendly / Turnstile / Umami / R2) ─
(csp) {
	header Content-Security-Policy "default-src 'self';
		script-src 'self' https://js.stripe.com https://challenges.cloudflare.com https://assets.calendly.com https://stats.lencre-humaine.com;
		style-src 'self' 'unsafe-inline' https://assets.calendly.com;
		img-src 'self' data: blob: https://cms.lencre-humaine.com https://*.r2.cloudflarestorage.com https://*.stripe.com;
		font-src 'self' data:;
		connect-src 'self' https://api.stripe.com https://cms.lencre-humaine.com https://stats.lencre-humaine.com https://challenges.cloudflare.com;
		frame-src https://js.stripe.com https://checkout.stripe.com https://challenges.cloudflare.com https://calendly.com https://assets.calendly.com;
		frame-ancestors 'self';
		base-uri 'self';
		form-action 'self' https://checkout.stripe.com;
		object-src 'none'"
}

# ── Site public (Nuxt/Nitro) ─────────────────────────────────────────────────
lencre-humaine.com, www.lencre-humaine.com {
	import security_headers
	import csp
	encode zstd gzip
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	}
	reverse_proxy web:3000
}

# ── CMS Directus ─────────────────────────────────────────────────────────────
cms.lencre-humaine.com {
	import security_headers
	encode zstd gzip
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	}
	reverse_proxy directus:8055
}

# ── Analytics Umami (self-hosted, cookieless) ────────────────────────────────
stats.lencre-humaine.com {
	import security_headers
	encode zstd gzip
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	}
	reverse_proxy umami:3000
}
